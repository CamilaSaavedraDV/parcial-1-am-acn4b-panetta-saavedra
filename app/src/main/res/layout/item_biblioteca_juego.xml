<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_tarjeta"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/imgJuegoBiblioteca"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreJuegoBiblioteca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/texto_principal"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGeneroJuegoBiblioteca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_secundario"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnEstadoInstalacion"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_boton_comprar"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/texto_principal"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDeseado"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_filtro"
                android:gravity="center"
                android:text="☆"
                android:textColor="@color/acento"
                android:textSize="21sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
