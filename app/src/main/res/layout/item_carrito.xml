<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margen_item"
    android:background="@drawable/bg_tarjeta"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/margen_pantalla">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_item"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/acento" />
    </LinearLayout>

    <Button
        android:id="@+id/btnQuitar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/acento_boton"
        android:text="@string/boton_quitar"
        android:textColor="@color/texto_boton" />
</LinearLayout>