<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margen_item"
    android:background="@drawable/bg_tarjeta"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/margen_pantalla">

    <TextView
        android:id="@+id/tvInicial"
        android:layout_width="@dimen/tamano_inicial"
        android:layout_height="@dimen/tamano_inicial"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:background="@drawable/bg_inicial"
        android:gravity="center"
        android:textColor="@color/texto_boton"
        android:textSize="@dimen/texto_inicial"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_item"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/acento" />
    </LinearLayout>

    <Button
        android:id="@+id/btnQuitar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_boton_borde"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/margen_item"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/margen_item"
        android:text="@string/boton_quitar"
        android:textAllCaps="false"
        android:textColor="@color/acento" />
</LinearLayout>